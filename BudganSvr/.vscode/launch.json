{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BudganSvr (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BudganSvr/bin/Debug/net10.0/BudganSvr.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BudganSvr",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5222"
      }
    },
    {
      "name": "compose.yaml.budgansvr",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "compose-up",
      "processId": "${command:pickProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "budgansvr-budgansvr-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/src/BudganSvr": "${workspaceFolder}/BudganSvr"
      }
    },
    {
      "name": "Docker: Attach to BudganSvr",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "budgansvr-budgansvr-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/src/BudganSvr": "${workspaceFolder}/BudganSvr"
      }
    }
  ]
}
