{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compose-up",
      "type": "shell",
      "command": "docker compose up --build -d && docker compose logs -f budgansvr | grep -m 1 'Waiting for debugger'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "compose-down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
